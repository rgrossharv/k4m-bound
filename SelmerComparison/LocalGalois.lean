/-!
# Local conditions are conditions in the cohomology of `ℚ_q`

`classicalSelmer` (in `Basic.lean`) states its local conditions through the decomposition
group `D_B ≤ G_ℚ` and inertia group `I_B ≤ D_B` of a place `B` of `ℚ̄` above `q`. Textbooks,
including Salmons' note (eq. (1) and §3.1), state them in the Galois cohomology of the local
field: a class must vanish in `H¹(ℚ_q, M) = H¹(Gal(ℚ̄_q/ℚ_q), M)` or in `H¹(I_{ℚ_q}, M)`. This
file proves that the two readings agree:

* `exists_localGalois`: `D_B` is isomorphic, *as a topological group*, to
  `Gal(ℚ̄_q/ℚ_q)` (`GK q ⊥`, automorphisms of the archive's `PadicAlgCl q` over `ℚ_q`), and the
  isomorphism carries `I_B` onto the local inertia group `inertiaK q ⊥`. The local inertia group
  is generated by the automorphisms that move every integral element by norm `< 1`. The input is
  the archive's `DecEquiv`, the `dec` field of its `Core`, which the archive proves from global
  Artin reciprocity, local Tate duality and the local Euler characteristic formula (`core`
  below). We pin the local field down to `ℚ_q` itself by computing its degree, `e·f = 1` over ℚ.
* `resDec_eq_zero_iff`, `resIne_eq_zero_iff`, `localCocycle_mem`: for a continuous cocycle `z`
  on `G_ℚ`, transport along that isomorphism gives a continuous cocycle on `Gal(ℚ̄_q/ℚ_q)`.
  The global class restricts to zero on `D_B` (resp. `I_B`) iff the transported cocycle is a
  coboundary on `Gal(ℚ̄_q/ℚ_q)` (resp. on the local inertia group).
* `mem_classicalSelmer_iff_local`: the classical Selmer group, with its conditions stated
  entirely in local Galois cohomology.

No `sorry`. The imports add about 1,200 archive modules to the light closure. They do not
include the 170,000-module `CorGKOf` closure.
-/

noncomputable section

open ReciprocityTheory.Gal Formalism.GaloisCohomology UpperTheory.V.Base Formalism.ConjugateSelfDual
open NumberField IsDedekindDomain

namespace SelmerComparison

set_option linter.unusedSectionVars false

/-! ## The archive's local-global input, proved -/

/-- The archive's `Core` package of class-field-theory facts, discharged by its proofs of global
Artin reciprocity, local Tate duality and the local Euler characteristic formula. -/
theorem core : ReciprocityTheory.ChartRestriction.T2.Core :=
  GlobalTheory.T.local_duality_class_field_facts_of_artin_tate_euler
    PositivityTheory.Stage1.PM.globalArtinReciprocity
    PositivityTheory.LocalTateOrthogonality.Gcoh.top_tate
    PositivityTheory.LocalTateOrthogonality.Gcoh.top_euler

/-- `Gal(ℚ̄_q/ℚ_q)`: automorphisms of the archive's algebraic closure of `ℚ_q` fixing `ℚ_q`. -/
abbrev GQloc (q : ℕ) [Fact q.Prime] : Type :=
  GK q (⊥ : IntermediateField ℚ_[q] (PadicAlgCl q))

/-- Every finite place of `ℚ` has `e · f = 1`. Copied from the archive, where it is `private`
(`UnitaryThreeDeformations/LocalEulerCharacteristicRationals.lean`). -/
theorem locDeg_rat (v : HeightOneSpectrum (𝓞 ℚ)) : locDeg v = 1 := by
  classical
  have : Fintype ((v.asIdeal.under ℤ).primesOver (NumberField.RingOfIntegers ℚ)) := Fintype.ofFinite _
  have hsum := Ideal.sum_ramification_inertia_eq_finrank (v.asIdeal.under ℤ) (NumberField.RingOfIntegers ℚ)
  rw [NumberField.RingOfIntegers.rank, Module.finrank_self] at hsum
  have hmem : v.asIdeal ∈ (v.asIdeal.under ℤ).primesOver (NumberField.RingOfIntegers ℚ) :=
    ⟨inferInstance, ⟨rfl⟩⟩
  have hle := Finset.single_le_sum
    (f := fun q : (v.asIdeal.under ℤ).primesOver (NumberField.RingOfIntegers ℚ) =>
      q.1.ramificationIdx ℤ * q.1.inertiaDeg ℤ) (fun _ _ => Nat.zero_le _)
    (Finset.mem_univ (⟨v.asIdeal, hmem⟩ : (v.asIdeal.under ℤ).primesOver _))
  have he := Ideal.ramificationIdx_pos v.asIdeal ℤ
  have hf := Ideal.inertiaDeg_pos v.asIdeal ℤ
  simp only at hle
  rw [hsum] at hle
  have := Nat.mul_pos he hf
  unfold locDeg
  omega

variable {Ω : Type} [Field Ω] [CharZero Ω] [IsAlgClosure ℚ Ω]

/-- **Decomposition group = local Galois group.** For a place `A` of `ℚ̄` above `q`, the
decomposition group is isomorphic as a topological group to `Gal(ℚ̄_q/ℚ_q)`, carrying inertia
to local inertia. -/
theorem exists_localGalois (q : ℕ) [Fact q.Prime] (A : ValuationSubring Ω)
    (hA : A.valuation (q : Ω) < 1) :
    ∃ i : ↥(A.decompositionSubgroup ℚ) ≃ₜ* GQloc q,
      ∀ g, i g ∈ inertiaK q ⊥ ↔ (g : G ℚ Ω) ∈ Ine (F := ℚ) A := by
  obtain ⟨K, _, i, -, hine, hdeg⟩ := core.dec (p := q) (F := ℚ) A hA
  have hne : A ≠ ⊤ := fun h => ((UpperTheory.V.Base.places ℚ Ω q A).2.1 h).2 hA
  obtain ⟨v, hv⟩ := (UpperTheory.V.Base.places ℚ Ω q A).1 hne
  have h1 : Module.finrank ℚ_[q] K = 1 := (hdeg v hv).trans (locDeg_rat v)
  have hK : K = ⊥ := IntermediateField.finrank_eq_one_iff.1 h1
  subst hK
  exact ⟨i, hine⟩

variable {R M : Type} [CommRing R] [AddCommGroup M] [Module R M] [TopologicalSpace M]
  [IsTopologicalAddGroup M] [ContinuousConstSMul R M]

section Transport

variable {q : ℕ} [Fact q.Prime] {A : ValuationSubring Ω}
  (i : ↥(A.decompositionSubgroup ℚ) ≃ₜ* GQloc q)

/-- `G_ℚ` as the subgroup `⊤`, the form `H1U ρ ⊤` uses. -/
abbrev toTop (g : G ℚ Ω) : (⊤ : Subgroup (G ℚ Ω)) := ⟨g, Subgroup.mem_top g⟩

/-- The `G_ℚ`-module `M`, viewed as a `Gal(ℚ̄_q/ℚ_q)`-module through `i`. -/
def localRep (ρ : Representation R (G ℚ Ω) M) : Representation R (GQloc q) M :=
  ρ.comp ((A.decompositionSubgroup ℚ).subtype.comp i.symm.toMonoidHom)

/-- A global cocycle, transported to `Gal(ℚ̄_q/ℚ_q)`. -/
def localCocycle {ρ : Representation R (G ℚ Ω) M} (z : Z1U ρ ⊤) : GQloc q → M :=
  fun g => z.1 (toTop (i.symm g).1)

/-- The transported cocycle is a *continuous* 1-cocycle of `Gal(ℚ̄_q/ℚ_q)`, so it defines a
class in `H¹(ℚ_q, M)`. -/
theorem localCocycle_mem (ρ : Representation R (G ℚ Ω) M) (z : Z1U ρ ⊤) :
    localCocycle i z ∈ Z1 (localRep i ρ) := by
  obtain ⟨hcont, hcoc⟩ := (mem_Z1_iff_cocycle _ _).1 z.2
  refine (mem_Z1_iff_cocycle _ _).2 ⟨?_, fun g h => ?_⟩
  · exact hcont.comp (Continuous.subtype_mk (continuous_subtype_val.comp i.symm.continuous) _)
  · have e : toTop (i.symm (g * h)).1 = toTop (i.symm g).1 * toTop (i.symm h).1 := by
      apply Subtype.ext; simp [toTop]
    simp only [localCocycle, e, hcoc]
    rfl

/-- **Locally trivial at `q` ⇔ zero in `H¹(ℚ_q, M)`.** -/
theorem resDec_eq_zero_iff (ρ : Representation R (G ℚ Ω) M) (z : Z1U ρ ⊤) :
    resU ρ (inf_le_left : (⊤ : Subgroup (G ℚ Ω)) ⊓ Dec (F := ℚ) A ≤ ⊤)
        (Submodule.Quotient.mk z) = 0 ↔
      ∃ m, ∀ g : GQloc q, localCocycle i z g = localRep i ρ g m - m := by
  rw [resU_mk_eq_zero]
  constructor
  · rintro ⟨m, hm⟩
    exact ⟨m, fun g => hm ⟨(i.symm g).1, Subgroup.mem_top _, (i.symm g).2⟩⟩
  · rintro ⟨m, hm⟩
    refine ⟨m, fun u => ?_⟩
    have e : i.symm.toMulEquiv (i ⟨u.1, u.2.2⟩) = ⟨u.1, u.2.2⟩ := i.symm_apply_apply ⟨u.1, u.2.2⟩
    have e' : i.symm (i ⟨u.1, u.2.2⟩) = ⟨u.1, u.2.2⟩ := i.symm_apply_apply ⟨u.1, u.2.2⟩
    have := hm (i ⟨u.1, u.2.2⟩)
    simp only [localCocycle, localRep, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      Subgroup.coe_subtype, toTop, e, e'] at this
    exact this

/-- **Unramified at `q` ⇔ zero in `H¹(I_{ℚ_q}, M)`.** -/
theorem resIne_eq_zero_iff (hi : ∀ g, i g ∈ inertiaK q ⊥ ↔ (g : G ℚ Ω) ∈ Ine (F := ℚ) A)
    (ρ : Representation R (G ℚ Ω) M) (z : Z1U ρ ⊤) :
    resU ρ (inf_le_left : (⊤ : Subgroup (G ℚ Ω)) ⊓ Ine (F := ℚ) A ≤ ⊤)
        (Submodule.Quotient.mk z) = 0 ↔
      ∃ m, ∀ g ∈ inertiaK q ⊥, localCocycle i z g = localRep i ρ g m - m := by
  rw [resU_mk_eq_zero]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m, fun g hg => ?_⟩
    have hI : ((i.symm g : ↥(A.decompositionSubgroup ℚ)) : G ℚ Ω) ∈ Ine (F := ℚ) A := by
      rw [← hi]; simpa using hg
    exact hm ⟨(i.symm g).1, Subgroup.mem_top _, hI⟩
  · rintro ⟨m, hm⟩
    refine ⟨m, fun u => ?_⟩
    let d : ↥(A.decompositionSubgroup ℚ) := ⟨u.1, Ine_le_Dec A u.2.2⟩
    have e : i.symm.toMulEquiv (i d) = d := i.symm_apply_apply d
    have e' : i.symm (i d) = d := i.symm_apply_apply d
    have := hm (i d) ((hi d).2 u.2.2)
    simp only [localCocycle, localRep, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      Subgroup.coe_subtype, toTop, e, e'] at this
    exact this

end Transport

/-! ## The classical Selmer group in local terms -/

/-- A choice, for each prime `q` and place `B q` above it, of the isomorphism of
`exists_localGalois`. -/
def localIso (B : Nat.Primes → ValuationSubring Ω)
    (hB : ∀ q : Nat.Primes, (B q).valuation (q : Ω) < 1) (q : Nat.Primes) :
    haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
    ↥((B q).decompositionSubgroup ℚ) ≃ₜ* GQloc q :=
  haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
  (exists_localGalois q (B q) (hB q)).choose

theorem localIso_inertia (B : Nat.Primes → ValuationSubring Ω)
    (hB : ∀ q : Nat.Primes, (B q).valuation (q : Ω) < 1) (q : Nat.Primes) :
    haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
    ∀ g, localIso B hB q g ∈ inertiaK q ⊥ ↔ (g : G ℚ Ω) ∈ Ine (F := ℚ) (B q) :=
  haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
  (exists_localGalois q (B q) (hB q)).choose_spec

/-- **The classical Selmer group with textbook local conditions.** A class `[z]` lies in
`classicalSelmer ρ B n` (equivalently, by `shaU_eq_classicalSelmer`, in the archive's
`ShaU ρ n ⊤`) iff, at every prime `q`, its image in `H¹(I_{ℚ_q}, M)` vanishes, and at every
prime `q ∣ n`, its image in `H¹(ℚ_q, M)` vanishes. -/
theorem mem_classicalSelmer_iff_local (ρ : Representation R (G ℚ Ω) M)
    (B : Nat.Primes → ValuationSubring Ω) (hB : ∀ q : Nat.Primes, (B q).valuation (q : Ω) < 1)
    (n : ℕ) (z : Z1U ρ ⊤) :
    (Submodule.Quotient.mk z : H1U ρ ⊤) ∈ classicalSelmer ρ B n ↔
      (∀ q : Nat.Primes, haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
        ∃ m, ∀ g ∈ inertiaK q ⊥,
          localCocycle (localIso B hB q) z g = localRep (localIso B hB q) ρ g m - m) ∧
      (∀ q : Nat.Primes, (q : ℕ) ∣ n → haveI : Fact (q : ℕ).Prime := ⟨q.2⟩
        ∃ m, ∀ g : GQloc q,
          localCocycle (localIso B hB q) z g = localRep (localIso B hB q) ρ g m - m) := by
  rw [classicalSelmer, mem_locSel]
  constructor
  · intro h
    refine ⟨fun q => ?_, fun q hq => ?_⟩
    · have : Fact (q : ℕ).Prime := ⟨q.2⟩
      exact (resIne_eq_zero_iff _ (localIso_inertia B hB q) ρ z).1 (h _ (Or.inl ⟨q, rfl⟩))
    · have : Fact (q : ℕ).Prime := ⟨q.2⟩
      exact (resDec_eq_zero_iff _ ρ z).1 (h _ (Or.inr ⟨q, hq, rfl⟩))
  · rintro ⟨hI, hD⟩ D (⟨q, rfl⟩ | ⟨q, hq, rfl⟩)
    · have : Fact (q : ℕ).Prime := ⟨q.2⟩
      exact (resIne_eq_zero_iff _ (localIso_inertia B hB q) ρ z).2 (hI q)
    · have : Fact (q : ℕ).Prime := ⟨q.2⟩
      exact (resDec_eq_zero_iff _ ρ z).2 (hD q hq)

end SelmerComparison

